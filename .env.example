# Copy to .env for `task run`. See docs/design.md for all variables.
# PROXIE_REDIS_URL is set by compose.yaml to the bundled Redis.
# Default upstream for tenants without their own PROXIE_UPSTREAM_URL_<TENANT>.
PROXIE_UPSTREAM_URL=https://api.anthropic.com
# At least one tenant is required. Callers send the key as X-Proxie-Key.
PROXIE_API_KEY_DEV=change-me
# PROXIE_UPSTREAM_URL_DEV=https://api.openai.com
PROXIE_LOG_FORMAT=text
# Host port for proxie (compose only).
# PROXIE_PORT=8080

# --- Local testing -----------------------------------------------------------
# `task request` sends one request through the running proxie built from these
# values. proxie ignores them, but compose passes this file into the proxie
# container as well, so use a provider key meant for testing.
# One of the PROXIE_API_KEY_<TENANT> keys above.
TEST_PROXIE_KEY=change-me
# Provider key, sent upstream as x-api-key.
TEST_PROVIDER_KEY=sk-ant-change-me
# Endpoint path after /v1/upstream, appended to the tenant's upstream URL.
TEST_ENDPOINT=/v1/messages
TEST_BODY='{"model":"claude-haiku-5-5","max_tokens":32,"messages":[{"role":"user","content":"Say hi in three words."}]}'

