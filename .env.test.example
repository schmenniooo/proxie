# Values for `task request`, which sends one test request through the running
# proxie. Copy to .env.test. Only the curl test container loads this file; the
# proxie container never sees it, so the provider key stays out of proxie.

# One of the PROXIE_API_KEY_<TENANT> keys from .env.proxie.
TEST_PROXIE_KEY=change-me
# Provider key, sent upstream as x-api-key. Use a key meant for testing.
TEST_PROVIDER_KEY=sk-ant-change-me
# Endpoint path after /v1/upstream, appended to the tenant's upstream base URL.
TEST_ENDPOINT=/v1/messages
TEST_BODY='{"model":"claude-haiku-5-5","max_tokens":32,"messages":[{"role":"user","content":"Say hi in three words."}]}'
