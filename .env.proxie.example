# proxie's own configuration for local development. Copy to .env.proxie.
# compose loads this file into the proxie container (task run), and Task reads
# it to fill in compose.yaml (PROXIE_PORT). See docs/design.md#configuration
# for all variables.
#
# Only proxie settings belong here. Provider keys do not: proxie never holds
# them, callers send their own with each request. Values for test requests go
# into .env.test, which the proxie container never sees.
#
# PROXIE_REDIS_URL and PROXIE_ADDR are set by compose.yaml.

# Default upstream base URL for tenants without their own
# PROXIE_UPSTREAM_URL_<TENANT>. The caller's path after /v1/upstream is
# appended to it, so use the host, not an endpoint like .../v1/messages.
PROXIE_UPSTREAM_URL=https://api.anthropic.com
# At least one tenant is required. Callers send the key as X-Proxie-Key.
PROXIE_API_KEY_DEV=change-me
# PROXIE_UPSTREAM_URL_DEV=https://api.openai.com
PROXIE_LOG_FORMAT=text
# Host port for proxie (compose only).
# PROXIE_PORT=8080
